version: '3.8'
services:
  api:
    build: .
    ports:
      - "8000:8000"
    volumes:
      - .:/app
      # Immutable Resource Manager: RootAI Base Truth
      - ./secure-code.yaml:/app/secure-code.yaml:ro
      - ./central-manifest.json:/app/central-manifest.json:ro
    environment:
      - NEO4J_URI=bolt://neo4j:7687
      - NEO4J_USER=neo4j
      - NEO4J_PASSWORD=rootai
    depends_on:
      neo4j:
        condition: service_healthy

  neo4j:
    image: neo4j:5.0
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      NEO4J_AUTH: neo4j/rootai
    healthcheck:
      test: ["CMD", "cypher-shell", "-u", "neo4j", "-p", "rootai", "RETURN 1"]
      interval: 10s
      timeout: 5s
      retries: 5
